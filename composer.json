{
    "name": "faffless/communication-channel",
    "description": "Laravel notification channel for sending messages through the Faffless Communication Hub service.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "faffless/hub-client": "^0.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "symfony/mailer": "^6.2|^7.0",
        "symfony/mime": "^6.2|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Faffless\\CommunicationChannel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Faffless\\CommunicationChannel\\FafflessHubChannelServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@bitbucket.org:GavinHoward/faffless-hub-client.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "cyclonedx/cyclonedx-php-composer": "^6.2"
    },
    "scripts": {
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "security:audit": "composer audit",
        "security:sbom": [
            "@php -r \"is_dir('build/sbom') || mkdir('build/sbom', 0775, true);\"",
            "composer CycloneDX:make-sbom --output-format=JSON --output-file=build/sbom/cyclonedx.json --spec-version=1.6 --output-reproducible"
        ],
        "security:semgrep": "semgrep scan --config auto .",
        "check": [
            "composer validate --strict",
            "composer security:audit",
            "composer security:sbom",
            "composer security:semgrep",
            "@lint"
        ]
    },
    "config": {
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    }
}
